---
import { getCollection } from 'astro:content';
import { mailto } from '../site.config';
import Arrow from './Arrow.astro';
interface Props { service?: string }
const { service } = Astro.props;
const items = (await getCollection('packages', (p) => !service || p.data.service === service)).sort((a, b) => a.data.order - b.data.order);
const names = { consulting: 'Consulting', fintech: 'Fintech', implementation: 'Implementation' } as const;
---
<div class:list={['grid gap-5', items.length > 2 ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-2']}>
  {items.map(({ data }) => (
    <article class="reveal card flex flex-col p-7">
      <div class="flex items-center justify-between gap-3">
        <span class="rounded-full border border-accent/30 bg-accent/10 px-2.5 py-0.5 text-xs font-medium text-accent">{data.duration}</span>
        {!service && <a href={`/services/${data.service}`} class="text-xs text-subtle hover:text-ink">{names[data.service]}</a>}
      </div>
      <h3 class="mt-5 text-xl font-semibold tracking-tight">{data.name}</h3>
      <p class="mt-3 flex-1 leading-relaxed text-muted">{data.description}</p>
      <div class="mt-6 flex items-center justify-between border-t border-line pt-5 text-sm">
        <span class="text-subtle">{data.price}</span>
        <a href={mailto(`${data.name} enquiry`)} class="group inline-flex items-center gap-1.5 font-medium text-accent">Ask about it <Arrow /></a>
      </div>
    </article>
  ))}
</div>
