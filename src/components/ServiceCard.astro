---
import Arrow from './Arrow.astro';
interface Props { index: number; title: string; summary: string; href: string; points: string[]; }
const { index, title, summary, href, points } = Astro.props;
---
<a href={href} class="reveal card card-hover group flex flex-col p-7 sm:p-8">
  <span class="font-mono text-xs text-subtle">0{index}</span>
  <h3 class="mt-6 text-2xl font-semibold tracking-tight">{title}</h3>
  <p class="mt-3 text-muted leading-relaxed">{summary}</p>
  <ul class="mt-6 space-y-2 text-sm text-muted">
    {points.slice(0, 3).map((p) => (
      <li class="flex gap-2.5"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent"></span>{p}</li>
    ))}
  </ul>
  <span class="mt-auto inline-flex items-center gap-1.5 pt-8 text-sm font-medium text-accent">Learn more <Arrow /></span>
</a>
