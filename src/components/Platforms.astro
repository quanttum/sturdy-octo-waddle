---
import { getCollection } from 'astro:content';
const items = (await getCollection('platforms')).sort((a, b) => a.data.order - b.data.order);
---
<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
  {items.map(({ data }) => (
    <article class="reveal card p-7">
      <p class="eyebrow">{data.type}</p>
      <h3 class="mt-3 text-lg font-semibold tracking-tight">{data.client}</h3>
      <ul class="mt-4 space-y-2 text-sm text-muted">
        {data.points.map((p) => <li class="flex gap-2.5"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent"></span>{p}</li>)}
      </ul>
    </article>
  ))}
</div>
