---
import Arrow from './Arrow.astro';
interface Props { href: string; title: string; client: string; sector: string; summary: string; year?: string; metrics: { value: string; label: string }[] }
const { href, title, client, sector, summary, year, metrics } = Astro.props;
---
<a href={href} class="reveal card card-hover group grid gap-8 p-7 sm:p-9 lg:grid-cols-[1.4fr_1fr] lg:items-center">
  <div>
    <p class="text-xs text-subtle"><span class="text-accent">{sector}</span> · {client}{year && ` · ${year}`}</p>
    <h3 class="mt-3 text-xl font-semibold tracking-tight text-balance sm:text-2xl">{title}</h3>
    <p class="mt-3 leading-relaxed text-muted">{summary}</p>
    <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent">Read case study <Arrow /></span>
  </div>
  <dl class="grid grid-cols-3 gap-4 border-t border-line pt-6 lg:border-t-0 lg:border-l lg:pl-8 lg:pt-0">
    {metrics.map((m) => (
      <div class:list={[metrics.length === 1 && 'col-span-3']}>
        <dd class="text-2xl font-semibold tracking-tight sm:text-3xl">{m.value}</dd>
        <dt class="mt-1 text-xs leading-snug text-subtle">{m.label}</dt>
      </div>
    ))}
  </dl>
</a>
