---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import CTA from '../components/CTA.astro';
import { site } from '../site.config';
const timeline = (await getCollection('timeline')).sort((a, b) => a.data.order - b.data.order);
const faq = [
  ['Do you only work with fintech companies?', 'Mostly, plus B2B software companies that connect to ERPs, payments or accounting systems.'],
  ['Do you advise or do the work?', 'Both. I write the specs, run partner calls and sit in deal reviews, and I hand over everything your team needs to continue.'],
  ['Can you work with our partners and sales team directly?', 'Yes. Most engagements include joint calls with your partners, account executives and customers.'],
  ['Where are you based?', 'Vancouver, on Pacific time. I work with teams across North America and Europe.'],
  ['How is pricing set?', 'Packages have a fixed price. Advisory is a monthly fee.'],
];
---
<Base title="About" description="Alexander Strelkov helps payments and finance-software companies grow through partners, integrations and AI agents.">
  <section class="container-x grid gap-12 pt-16 pb-12 sm:pt-24 lg:grid-cols-[1.3fr_1fr] lg:items-start">
    <div>
      <p class="eyebrow">About</p>
      <h1 class="h-display mt-3">Hi, I'm Alex.</h1>
      <div class="mt-8 space-y-5 text-lg leading-relaxed text-muted">
        <p>I started in enterprise systems: SAP finance integrations at Air Liquide, one of the first e-invoicing rollouts in its region at Unilever, and an order-to-cash ERP programme for Stellantis inside Capgemini, covering EMEA and Asia-Pacific.</p>
        <p>At Inovatec I moved into lending software. I led the pre-sales and implementation team that delivered an enterprise lending platform for a major Canadian bank in nine months, built an embedded lending marketplace with eight lenders, and launched financing programs for major automotive, powersports and equipment brands.</p>
        <p>At Tipalti I joined as a delivery manager on complex enterprise implementations, then moved to product and partnerships. I lead the embedded payments practice across partners, built the systems-integrator certification program, delivered ERP integrations, and took an AI agent into production for more than 600 colleagues.</p>
      </div>
      <p class="mt-8 text-sm text-subtle">{site.location}</p>
    </div>
    <div class="reveal relative mx-auto aspect-square w-full max-w-md overflow-hidden rounded-3xl border border-line bg-surface lg:mt-10">
      {site.photo
        ? <img src={site.photo} alt={`Portrait of ${site.name}`} class="h-full w-full object-cover" width="400" height="400" />
        : <div class="grid h-full place-items-center"><span class="text-8xl font-semibold tracking-tight text-line">{site.initials}</span></div>}
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-bg/30 via-transparent to-transparent"></div>
    </div>
  </section>

  <Section eyebrow="Experience" title="Career">
    <ol class="relative border-l border-line">
      {timeline.map(({ data }) => (
        <li class="reveal relative pb-10 pl-8 last:pb-0">
          <span class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full border-2 border-bg bg-accent"></span>
          <p class="text-sm font-medium text-accent">{data.period}</p>
          <h3 class="mt-1 text-lg font-semibold">{data.role} <span class="font-normal text-muted">· {data.org}</span></h3>
          <p class="mt-2 max-w-2xl leading-relaxed text-muted">{data.note}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section eyebrow="Education" title="Background" class="!pt-0">
    <div class="reveal card max-w-2xl p-6">
      <p class="font-semibold">Master's degree, Computer Science and Chemical Technology</p>
      <p class="mt-1 text-muted">Lomonosov Moscow State University</p>
    </div>
  </Section>

  <Section eyebrow="FAQ" title="Common questions" class="!pt-0">
    <div class="max-w-3xl divide-y divide-line border-y border-line">
      {faq.map(([q, a]) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-medium [&::-webkit-details-marker]:hidden">
            {q}
            <span class="text-xl leading-none text-accent transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-muted">{a}</p>
        </details>
      ))}
    </div>
  </Section>
  <CTA title="Let's talk" />
</Base>
